# Environment variables for LynceusVision
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_use_openssl_rand_-hex_32
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (recommended for all environments)
DATABASE_URL=postgresql+asyncpg://lynceus:lynceus@localhost:5432/lynceusvision

# SQLite development fallback — uncomment and set explicitly if needed
# DATABASE_URL=sqlite+aiosqlite:///./lynceusvision-dev.db

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Connector: Shodan (planned) ───────────────────────────────────────────────
# SHODAN_API_KEY=

# ── Connector: VirusTotal (planned) ──────────────────────────────────────────
# VIRUSTOTAL_API_KEY=

# ── Connector: Hunter.io (planned) ────────────────────────────────────────────
# HUNTERIO_API_KEY=

# ── Connector: Censys (planned) ───────────────────────────────────────────────
# CENSYS_API_ID=
# CENSYS_API_SECRET=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
